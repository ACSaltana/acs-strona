---
import ListaWpisow from '../../../components/strony/ListaWpisow.astro';
import { stronaListy, stronyListy } from '../../../lib/aktualnosci';

export async function getStaticPaths() {
  // strona 1 to /aktualnosci
  return (await stronyListy()).slice(1).map((lista) => ({ params: { strona: String(lista.strona) } }));
}

const lista = await stronaListy(undefined, Astro.params.strona);
if (!lista) return new Response(null, { status: 404 });
---

<ListaWpisow {...lista} />
