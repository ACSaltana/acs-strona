---
import ListaWpisow from '../../../../components/strony/ListaWpisow.astro';
import { stronaListy } from '../../../../lib/aktualnosci';
import { KATEGORIE } from '../../../../lib/tresc';

export function getStaticPaths() {
  return KATEGORIE.map((kategoria) => ({ params: { kategoria: kategoria.slug } }));
}

const lista = await stronaListy(Astro.params.kategoria);
if (!lista) return new Response(null, { status: 404 });
---

<ListaWpisow {...lista} />
