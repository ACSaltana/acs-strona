---
import Layout from '../layouts/Layout.astro';
import Backdrop from '../components/Backdrop.astro';
import Button from '../components/Button.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Logo from '../components/Logo.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TournamentHero from '../components/TournamentHero.astro';
import { NAZWA, aktualnyTurniej, grafikaOg, pobierzTeksty, pobierzUstawienia, pobierzWpisy } from '../lib/tresc';

const [teksty, ustawienia, turniej, wpisy] = await Promise.all([pobierzTeksty(), pobierzUstawienia(), aktualnyTurniej(), pobierzWpisy()]);
const najnowsze = wpisy.slice(0, 3);
const { glowna } = teksty;
// Słowa tytułu wchodzą po kolei; od piątego razem, żeby długi tytuł nie opóźniał reszty hero.
// Odstęp jest w środku słowa (white-space: pre), bo między blokami na końcu wiersza Safari go gubi.
const slowa = glowna.tytul.split(/\s+/).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: NAZWA,
  alternateName: 'ACS',
  url: new URL('/', Astro.site).href,
  description: ustawienia.opis,
  sameAs: ustawienia.socials.map((s) => s.href).filter(Boolean),
};
---

<Layout description={ustawienia.opis} image={await grafikaOg(turniej?.baner)} jsonLd={jsonLd} bands>
  <section class="p-band p-stage">
    <Backdrop variant="hero" />
    <div class="p-wrap">
      <div class="p-hero p-intro">
        <div>
          <div class="label p-accent">{glowna.etykieta}</div>
          <h1 class="display-xl p-title">
            {slowa.map((slowo, i) => <span class="p-intro__word" style={`--i:${Math.min(i, 4)}`}>{i < slowa.length - 1 ? `${slowo} ` : slowo}</span>)}
          </h1>
          {glowna.lead && <p class="lead p-lead p-lead--hero p-intro__lead">{glowna.lead}</p>}
          <div class="p-row p-mt-10 p-intro__actions">
            <Button href="#aktualnosci" variant="accent" icon="↓">Aktualności</Button>
            <Button href="/o-nas" variant="secondary">O nas</Button>
          </div>
        </div>
        <Logo draw label={`Logo ${NAZWA}`} class="p-intro__logo" />
      </div>
    </div>
  </section>

  <section class="p-band">
    <Backdrop variant="light" />
    {/* baner turnieju pojawia się dopiero przy przewijaniu i chowa po powrocie na górę: skrypt na dole pliku */}
    <div class="p-wrap p-anchor p-reveal" id="turniej" data-reveal>
      {
        turniej ? (
          <TournamentHero title={turniej.edycja} status={turniej.status} game={turniej.gra} kicker={turniej.kicker} prizePool={turniej.pula} format={turniej.format} date={turniej.data} teams={turniej.liczbaDruzynBaner} image={turniej.baner} imageAlt={turniej.opisGrafiki} href={turniej.href} priority />
        ) : (
          <div class="p-empty">
            <p class="lead">Brak nadchodzących turniejów. Nowe ogłaszamy w Aktualnościach.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="p-band">
    <Backdrop variant="dark" />
    <div class="p-wrap p-anchor" id="aktualnosci">
      <SectionHeader index="01" eyebrow="Aktualności" title="Aktualności" href="/aktualnosci">
        <Button href="/aktualnosci" variant="ghost" icon="→">Wszystkie wpisy</Button>
      </SectionHeader>
      {
        najnowsze.length > 0 ? (
          <div class="p-cols-3 p-mt-8">
            {najnowsze.map((w) => (
              <PostCard title={w.tytul} date={w.dataTekst} dateTime={w.data} category={w.kategoria.nazwa} excerpt={w.zajawka} image={w.okladka} imageAlt={w.opisOkladki} href={w.href} />
            ))}
          </div>
        ) : (
          <div class="p-empty p-mt-8">
            <p class="lead">Nie ma jeszcze wpisów.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="p-band">
    <Backdrop variant="mid" />
    <div class="p-wrap">
      <ContactBlock email={ustawienia.email} eyebrow="02 / Kontakt" topics={glowna.kontaktTematy} />
    </div>
  </section>
</Layout>

<script>
  // Baner turnieju pokazuje się, gdy przy przewijaniu wjeżdża na ekran, i chowa, gdy wraca pod jego dół (powrót na górę strony).
  // Bez skryptu i przy ograniczonym ruchu jest widoczny cały czas.
  const baner = document.querySelector<HTMLElement>('[data-reveal]');
  if (baner && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let czeka = false;
    const ustaw = () => {
      czeka = false;
      // granica to 88% wysokości ekranu: baner musi wyraźnie wjechać, zanim się pokaże
      baner.dataset.reveal = baner.getBoundingClientRect().top < window.innerHeight * 0.88 ? 'shown' : 'hidden';
    };
    const zaplanuj = () => {
      if (!czeka) {
        czeka = true;
        requestAnimationFrame(ustaw);
      }
    };
    ustaw();
    window.addEventListener('scroll', zaplanuj, { passive: true });
    window.addEventListener('resize', zaplanuj);
  }
</script>
