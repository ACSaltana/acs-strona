---
import Img from './Img.astro';
import type { Grafika, NavItem } from '../lib/typy';

interface Props {
  items: NavItem[];
  /** href bieżącej podstrony */
  current?: string;
  /** Plik logo (biała wersja); bez niego znak jest składany tekstem */
  logo?: Grafika;
  /** Adres e-mail pokazany na dole menu mobilnego */
  email?: string;
  class?: string;
}

const { items, current, logo, email, class: className } = Astro.props;
---

<header class:list={['acs-header', className]}>
  <a class="acs-wordmark" href="/" aria-label="Altana Championship Series, strona główna">
    {
      logo ? (
        <Img src={logo} alt="" widths={[160, 320]} sizes="160px" priority />
      ) : (
        <>
          <span class="acs-wordmark__short">ACS</span>
          <span class="acs-wordmark__long">Altana Championship Series</span>
        </>
      )
    }
  </a>
  <nav class="acs-nav" aria-label="Główna">
    <ul class="acs-nav__list">
      {items.map((it) => (
        <li><a class="acs-nav__link" href={it.href} aria-current={it.href === current ? 'page' : undefined}>{it.label}</a></li>
      ))}
    </ul>
    <slot />
    <button type="button" class="acs-btn acs-btn--secondary acs-btn--sm acs-nav__menu" aria-expanded="false" aria-controls="menu" aria-haspopup="dialog">Menu</button>
  </nav>
</header>

{/* Menu mobilne (<1024px): pełnoekranowy panel bg z linkami heading-1. <dialog> daje pułapkę fokusu i zamykanie klawiszem Esc. */}
<dialog class="acs-menu" id="menu" aria-label="Menu">
  <div class="acs-header">
    <a class="acs-wordmark" href="/" aria-label="Altana Championship Series, strona główna">
      <span class="acs-wordmark__short">ACS</span>
      <span class="acs-wordmark__long">Altana Championship Series</span>
    </a>
    <button type="button" class="acs-btn acs-btn--secondary acs-btn--sm" data-menu-close>Zamknij</button>
  </div>
  <nav aria-label="Menu">
    <ul class="acs-menu__list">
      {items.map((it) => (
        <li>
          <a class="acs-menu__link heading-1" href={it.href} aria-current={it.href === current ? 'page' : undefined}>
            {it.label}
            <span class="acs-menu__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {email && (
    <div class="acs-menu__foot">
      <div class="acs-label">Napisz do nas</div>
      <a class="meta" href={`mailto:${email}`}>{email}</a>
    </div>
  )}
</dialog>

<script>
  const button = document.querySelector<HTMLButtonElement>('.acs-nav__menu');
  const menu = document.querySelector<HTMLDialogElement>('#menu');
  if (button && menu) {
    button.addEventListener('click', () => {
      menu.showModal();
      button.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('close', () => button.setAttribute('aria-expanded', 'false'));
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // link do kotwicy na tej samej stronie nie przeładowuje dokumentu, więc panel trzeba zamknąć ręcznie
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
    // po poszerzeniu okna wraca zwykła nawigacja
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>
