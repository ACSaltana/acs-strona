---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/bundle.css';
import '../styles/pages.css';
import displayFont from '@fontsource/saira-condensed/files/saira-condensed-latin-700-normal.woff2?url';
import sansFont from '@fontsource/saira/files/saira-latin-400-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { NAV, NAZWA, SKROT, aktualnyTurniej, pobierzUstawienia } from '../lib/tresc';

interface Props {
  /** Tytuł podstrony bez nazwy serwisu; na stronie głównej pomiń */
  title?: string;
  description: string;
  /** Adres grafiki do udostępniania (OG), bezwzględny albo od korzenia strony */
  image?: string;
  type?: 'website' | 'article';
  /** Dane strukturalne schema.org */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type = 'website', jsonLd } = Astro.props;
const pageTitle = title ? `${title} — ${SKROT}` : `${SKROT} — ${NAZWA}. Turnieje Counter-Strike 2`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
const current = NAV.find((it) => path === it.href || path.startsWith(`${it.href}/`))?.href;

const [ustawienia, turniej] = await Promise.all([pobierzUstawienia(), aktualnyTurniej()]);
// „Regulamin” w stopce prowadzi do zasad aktualnego turnieju
const stopka = turniej ? [...NAV, { label: 'Regulamin', href: `${turniej.href}#regulamin` }] : NAV;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={NAZWA} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? `${SKROT} — ${NAZWA}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="p-root">
      <a class="acs-btn acs-btn--primary acs-btn--sm p-skip" href="#tresc">Przejdź do treści</a>
      <SiteHeader items={NAV} current={current} logo={ustawienia.logo} email={ustawienia.email} />
      <main class="p-main" id="tresc">
        <slot />
      </main>
      <SiteFooter links={stopka} socials={ustawienia.socials} />
    </div>
  </body>
</html>
